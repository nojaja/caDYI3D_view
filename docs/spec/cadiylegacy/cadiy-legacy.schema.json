{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "caDIY3D Legacy (.cadiy) XML Schema Definition",
  "description": "caDIY3D 旧バージョン (Version 7.0) の XML データモデルおよびパース後の中間オブジェクトスキーマ",
  "type": "object",
  "required": ["_2xModel"],
  "properties": {
    "_2xModel": {
      "type": "object",
      "required": ["Version", "Camera", "_2xObject"],
      "properties": {
        "Version": {
          "type": "string",
          "description": "プロジェクト内部バージョン。通常 '7.0'"
        },
        "Thumbnail": {
          "type": "string",
          "description": "Base64エンコードされたサムネイルバイナリ"
        },
        "Camera": {
          "type": "object",
          "required": ["Position", "Center"],
          "properties": {
            "Position": { "type": "string", "pattern": "^-?[0-9.]+,-?[0-9.]+,-?[0-9.]+$" },
            "Center": { "type": "string", "pattern": "^-?[0-9.]+,-?[0-9.]+,-?[0-9.]+$" },
            "viewMode": { "type": "string" },
            "fov": { "type": "string" },
            "dist": { "type": "string" },
            "nearZ": { "type": "string" },
            "farZ": { "type": "string" },
            "phai": { "type": "string" },
            "theta": { "type": "string" },
            "ViewingMode": { "type": "string" },
            "RealPrintFrameMode": { "type": "string" },
            "SceneDrawMode": { "type": "string" },
            "ScenePartsNameMode": { "type": "string" },
            "LayerColorMode": { "type": "string" }
          }
        },
        "_2xLayer": {
          "type": "object",
          "properties": {
            "_2xLayerInfoItem": {
              "oneOf": [
                { "$ref": "#/definitions/LayerInfoItem" },
                {
                  "type": "array",
                  "items": { "$ref": "#/definitions/LayerInfoItem" }
                }
              ]
            }
          }
        },
        "_2xPaint": {
          "type": "object",
          "properties": {
            "_2xPaintings": {
              "oneOf": [
                { "$ref": "#/definitions/LegacyPaintings" },
                {
                  "type": "array",
                  "items": { "$ref": "#/definitions/LegacyPaintings" }
                }
              ]
            }
          }
        },
        "_2xBooleanMeshInfo": {
          "type": "object",
          "properties": {
            "_2xBooleanMeshInfo": {
              "oneOf": [
                { "$ref": "#/definitions/BooleanMeshInfo" },
                {
                  "type": "array",
                  "items": { "$ref": "#/definitions/BooleanMeshInfo" }
                }
              ]
            }
          }
        },
        "_2xPictureImageInfos": {
          "type": "object",
          "properties": {
            "_2xPictureImageInfo": {
              "oneOf": [
                { "$ref": "#/definitions/PictureImageInfo" },
                {
                  "type": "array",
                  "items": { "$ref": "#/definitions/PictureImageInfo" }
                }
              ]
            }
          }
        },
        "_2xObject": {
          "type": "object",
          "properties": {
            "_2xBoard": {
              "oneOf": [
                { "$ref": "#/definitions/LegacyBoard" },
                { "type": "array", "items": { "$ref": "#/definitions/LegacyBoard" } }
              ]
            },
            "_2xLumber": {
              "oneOf": [
                { "$ref": "#/definitions/LegacyLumber" },
                { "type": "array", "items": { "$ref": "#/definitions/LegacyLumber" } }
              ]
            },
            "_2xCylinder": {
              "oneOf": [
                { "$ref": "#/definitions/LegacyCylinder" },
                { "type": "array", "items": { "$ref": "#/definitions/LegacyCylinder" } }
              ]
            },
            "_2xComment": {
              "oneOf": [
                { "$ref": "#/definitions/LegacyComment" },
                { "type": "array", "items": { "$ref": "#/definitions/LegacyComment" } }
              ]
            },
            "_2xPolygon": {
              "oneOf": [
                { "$ref": "#/definitions/LegacyPolygon" },
                { "type": "array", "items": { "$ref": "#/definitions/LegacyPolygon" } }
              ]
            },
            "_2xBoolean": {
              "oneOf": [
                { "$ref": "#/definitions/LegacyBoolean" },
                { "type": "array", "items": { "$ref": "#/definitions/LegacyBoolean" } }
              ]
            },
            "_2xScrew": {
              "oneOf": [
                { "$ref": "#/definitions/LegacyScrew" },
                { "type": "array", "items": { "$ref": "#/definitions/LegacyScrew" } }
              ]
            },
            "_2xDiyMaterial": {
              "oneOf": [
                { "$ref": "#/definitions/LegacyDiyMaterial" },
                { "type": "array", "items": { "$ref": "#/definitions/LegacyDiyMaterial" } }
              ]
            },
            "_2xPicture": {
              "oneOf": [
                { "$ref": "#/definitions/LegacyPicture" },
                { "type": "array", "items": { "$ref": "#/definitions/LegacyPicture" } }
              ]
            },
            "_2xDimension": {
              "oneOf": [
                { "$ref": "#/definitions/LegacyDimension" },
                { "type": "array", "items": { "$ref": "#/definitions/LegacyDimension" } }
              ]
            }
          }
        },
        "CutList": {
          "type": "object",
          "properties": {
            "CutListPartsSeparator": {
              "oneOf": [
                { "$ref": "#/definitions/CutListPartsSeparator" },
                { "type": "array", "items": { "$ref": "#/definitions/CutListPartsSeparator" } }
              ]
            },
            "CutListPartsBase": {
              "oneOf": [
                { "$ref": "#/definitions/CutListPartsBase" },
                { "type": "array", "items": { "$ref": "#/definitions/CutListPartsBase" } }
              ]
            }
          }
        }
      }
    }
  },
  "definitions": {
    "LayerInfoItem": {
      "type": "object",
      "required": ["LayerID", "LayerName"],
      "properties": {
        "LayerID": { "type": "string" },
        "LayerName": { "type": "string" },
        "LayerVisible": { "type": "string", "enum": ["true", "false"] },
        "LayerLocked": { "type": "string", "enum": ["true", "false"] },
        "LayerColor": { "type": "string" },
        "LayerColorMode": { "type": "string" }
      }
    },
    "BooleanMeshInfo": {
      "type": "object",
      "description": "旧形式におけるブーリアン・ポリゴンメッシュ幾何データ定義コンテナ。頂点群と面リストを保持する。",
      "required": ["BooleanMeshInfoID", "MeshVertex"],
      "properties": {
        "BooleanMeshInfoID": {
          "type": "string",
          "description": "メッシュの一意な識別ID (1, 2, ...)。_2xBoolean.MeshInfoID と紐づく。"
        },
        "MeshVertex": {
          "type": "string",
          "description": "頂点座標リスト。形式: 'x,y,z/x,y,z/...'。単位はメートル [m]（※V4 の polygonMeshTable は cm 単位のため変換時に 100 倍が必要）。"
        },
        "MeshFaceInfo": {
          "description": "面定義コンテナまたはその配列。FInfo を含む。",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "FInfo": {
                  "type": "string",
                  "description": "面トポロジおよび法線情報文字列。'頂点数#スムーズフラグ#マテリアルID#頂点インデックス(0,1,2)#エッジフラグ#頂点法線(nx,ny,nz/...)#面法線(nx,ny,nz)'"
                }
              }
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "FInfo": {
                    "type": "string",
                    "description": "面トポロジおよび法線情報文字列。'頂点数#スムーズフラグ#マテリアルID#頂点インデックス(0,1,2)#エッジフラグ#頂点法線(nx,ny,nz/...)#面法線(nx,ny,nz)'"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "PictureImageInfo": {
      "type": "object",
      "required": ["ImageBase64ID", "ImageBase64"],
      "properties": {
        "ImageBase64ID": { "type": "string" },
        "ImageBase64": { "type": "string" }
      }
    },
    "CommonLegacyObject": {
      "type": "object",
      "required": ["UniqueID", "Location", "Quaternion", "Size"],
      "properties": {
        "UniqueID": { "type": "string" },
        "ModelType": { "type": "string" },
        "CommentText": { "type": "string" },
        "SubPartsName": { "type": "string" },
        "LinkedCutPartsText": { "type": "string" },
        "Location": { "type": "string" },
        "Quaternion": { "type": "string" },
        "Size": { "type": "string" },
        "StandardSize": { "type": "string" },
        "Diffuse": { "type": "string" },
        "PaintDiffuse": { "type": "string" },
        "Specular": { "type": "string" },
        "PaintSpecular": { "type": "string" },
        "PaintID": { "type": "string" },
        "UnitPrice": { "type": "string" },
        "SpecificGravity": { "type": "string" },
        "Remarks": { "type": "string" },
        "GroupID": { "type": "string" },
        "Layer": { "type": "string" },
        "Hide": { "type": "string", "enum": ["true", "false"] },
        "Texture": { "type": "string" },
        "ObjectTextureID": { "type": "string" },
        "PlywoodTextureID": { "type": "string" },
        "NoAggregated": { "type": "string", "enum": ["true", "false"] },
        "Dummy": { "type": "string" },
        "Style": { "type": "string" },
        "NumberPerSet": { "type": "string" },
        "SameSetID": { "type": "string" },
        "IsSubParts": { "type": "string" },
        "HasGuidanceURL": { "type": "string" },
        "GroupCriteria": { "type": "string" },
        "CutValue": { "type": "string" },
        "RoundValue": { "type": "string" },
        "RoundModes": { "type": "string" }
      }
    },
    "LegacyPaintings": {
      "type": "object",
      "required": ["PaintID", "PaintName", "PaintColor"],
      "properties": {
        "PaintID": { "type": "string" },
        "PaintName": { "type": "string" },
        "PaintColor": { "type": "string" },
        "PaintSpecular": { "type": "string" },
        "PaintMaker": { "type": "string" },
        "PaintBrand": { "type": "string" },
        "PaintURL": { "type": "string" },
        "PaintImage": { "type": "string" },
        "PaintInfo": { "type": "string" },
        "PaintTextureID": { "type": "string" }
      }
    },
    "LegacyLumber": {
      "allOf": [
        { "$ref": "#/definitions/CommonLegacyObject" }
      ]
    },
    "LegacyComment": {
      "allOf": [
        { "$ref": "#/definitions/CommonLegacyObject" },
        {
          "type": "object",
          "properties": {
            "LinePattern": { "type": "string" },
            "LineWidth": { "type": "string" },
            "LineColor": { "type": "object" },
            "ArrowPoint": { "type": "object" },
            "SnapVector": { "type": "object" },
            "LineEndType": { "type": "string" }
          }
        }
      ]
    },
    "LegacyBoard": {
      "allOf": [
        { "$ref": "#/definitions/CommonLegacyObject" },
        {
          "type": "object",
          "properties": {
            "CutValue": { "type": "string" },
            "RoundValue": { "type": "string" },
            "RoundModes": { "type": "string" }
          }
        }
      ]
    },
    "LegacyCylinder": {
      "allOf": [
        { "$ref": "#/definitions/CommonLegacyObject" },
        {
          "type": "object",
          "properties": {
            "CutValue": { "type": "string" },
            "RoundValue": { "type": "string" },
            "RoundModes": { "type": "string" }
          }
        }
      ]
    },
    "LegacyDimension": {
      "allOf": [
        { "$ref": "#/definitions/CommonLegacyObject" },
        {
          "type": "object",
          "properties": {
            "LinePattern1": { "type": "string" },
            "LinePattern2": { "type": "string" },
            "LineWidth": { "type": "string" },
            "LineEndType": { "type": "string" },
            "TextVisibled": { "type": "string" },
            "PosDimensionValue": { "type": "string" },
            "DimensionSymbol": { "type": "string" }
          }
        }
      ]
    },
    "LegacyScrew": {
      "allOf": [
        { "$ref": "#/definitions/CommonLegacyObject" },
        {
          "type": "object",
          "properties": {
            "ScrewLength": { "type": "string" },
            "ScrewDiameter": { "type": "string" },
            "ScrewLayout": { "type": "string" },
            "ScrewType": { "type": "string" },
            "ScrewColor": { "type": "object" },
            "LineColor": { "type": "object" },
            "DispDimension": { "type": "string" },
            "ScrewPosition": { "type": "string" }
          }
        }
      ]
    },
    "LegacyPolygon": {
      "type": "object",
      "description": "外部3Dパーツ・金物（dmesh）。デスクトップアプリ側のライブラリから ModelName で指定された .dmesh ファイルを読み込む。",
      "allOf": [
        { "$ref": "#/definitions/CommonLegacyObject" },
        {
          "type": "object",
          "properties": {
            "ModelName": {
              "type": "string",
              "description": "外部 3D メッシュファイル相対パス (例: 'Concrete\\Base-Stone With Paddle 240.dmesh')"
            }
          }
        }
      ]
    },
    "LegacyBoolean": {
      "type": "object",
      "description": "ブーリアン・加工部材または埋め込みポリゴンパーツ。OriginalModelType が 'eModelTypePolygon' の場合は金物パーツ等を表し、MeshInfoID で _2xBooleanMeshInfo を参照する。",
      "allOf": [
        { "$ref": "#/definitions/CommonLegacyObject" },
        {
          "type": "object",
          "properties": {
            "MeshInfoID": {
              "type": "string",
              "description": "参照先 BooleanMeshInfo の BooleanMeshInfoID (例: '1')"
            },
            "OriginalModelType": {
              "type": "string",
              "description": "元のモデル種別。'eModelTypePolygon' の場合はポリゴンオブジェクトとして V4 に変換される。"
            },
            "SnapVertex": {
              "type": "string",
              "description": "スナップ用頂点リスト 'x,y,z/x,y,z/...'"
            },
            "FaceInfoList": {
              "description": "部材のバウンディングボックス面や属性面リスト",
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "FInfo": { "type": "string" }
                  }
                },
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "FInfo": { "type": "string" }
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "LegacyDiyMaterial": {
      "allOf": [
        { "$ref": "#/definitions/CommonLegacyObject" },
        {
          "type": "object",
          "properties": {
            "DiyMaterialType": { "type": "string" },
            "Thickness": { "type": "string" }
          }
        }
      ]
    },
    "LegacyPicture": {
      "allOf": [
        { "$ref": "#/definitions/CommonLegacyObject" },
        {
          "type": "object",
          "properties": {
            "ImageBase64ID": { "type": "string" },
            "ImagePath": { "type": "string" },
            "AspectRatioFixed": { "type": "string" },
            "AspectRatio": { "type": "string" },
            "ImageMode": { "type": "string" },
            "FontSize": { "type": "string" },
            "FontStyle": { "type": "string" },
            "FontFamily": { "type": "string" },
            "FrameVisibled": { "type": "string" },
            "ForeColor": { "type": "string" },
            "BackColor": { "type": "string" },
            "BackColorMode": { "type": "string" }
          }
        }
      ]
    },
    "CutListPartsSeparator": {
      "type": "object",
      "properties": {
        "PartsType": { "type": "string" },
        "Size": { "type": "string" },
        "Title": { "type": "string" },
        "Info": { "type": "string" },
        "ModleType": { "type": "string" }
      }
    },
    "CutListPartsBase": {
      "type": "object",
      "properties": {
        "PartsType": { "type": "string" },
        "Size": { "type": "string" },
        "UnitPrice": { "type": "string" },
        "ModelType": { "type": "string" },
        "PartsName": { "type": "string" },
        "Weight": { "type": "string" },
        "SpecificGravity": { "type": "string" },
        "Parts": {
          "type": "object",
          "properties": {
            "CutParts": {
              "oneOf": [
                { "$ref": "#/definitions/CutPartItem" },
                { "type": "array", "items": { "$ref": "#/definitions/CutPartItem" } }
              ]
            }
          }
        }
      }
    },
    "CutPartItem": {
      "type": "object",
      "properties": {
        "CutID": { "type": "string" },
        "ArrangeTB": { "type": "string" },
        "ArrangeLR": { "type": "string" },
        "PartsText": { "type": "string" },
        "Location": { "type": "string" }
      }
    }
  }
}
